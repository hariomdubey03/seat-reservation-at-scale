# Local development only. Compose has the same defaults for a one-command start.
# Generate distinct random AUTH_SECRET and ADMIN_TOKEN values before public deployment.
DATABASE_URL=postgresql://reservation:local-reservation-password@127.0.0.1:5433/reservation
POSTGRES_PASSWORD=local-reservation-password
POSTGRES_PORT=5433
AUTH_SECRET=local-development-secret-change-before-deployment
ADMIN_TOKEN=local-admin-token-change-before-deployment
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=180
TOKEN_TTL_SECONDS=86400
LOG_LEVEL=INFO
API_PORT=8000
PORT=8000
