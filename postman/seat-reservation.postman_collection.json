{
  "info": {
    "name": "Seat Reservation \u2014 Reviewer Walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Import the environment and set admin_token privately. Creates isolated demo records; no existing data is deleted. Tests cover replay, conflicts, quota, identity, owner cancellation and reconciliation. Use scripts/burst.py for concurrency."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://seats.algocrafter.in"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "show_id",
      "value": ""
    },
    {
      "key": "alice_token",
      "value": ""
    },
    {
      "key": "bob_token",
      "value": ""
    },
    {
      "key": "reservation_id",
      "value": ""
    },
    {
      "key": "bob_reservation_id",
      "value": ""
    },
    {
      "key": "last_request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/live",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/ready",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create a fresh show",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows",
        "description": "Start here on every new collection run. Saves a fresh show_id and run_id.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"review-{{run_id}}\",\n  \"seats\": [\n    \"A1\",\n    \"A2\",\n    \"A3\",\n    \"A4\",\n    \"A5\",\n    \"A6\"\n  ],\n  \"price_paise\": 25000,\n  \"per_user_limit\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"show_id\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Issue alice token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/token",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"review-alice-{{run_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"alice_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Issue bob token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/token",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"review-bob-{{run_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"bob_token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Alice reserves A1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A1\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-alice-first\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"reservation_id\", pm.response.json().reservation_id);",
              "pm.test(\"Integer paise\", () => pm.expect(pm.response.json().amount_paise).to.eql(25000));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Same request replays",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A1\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-alice-first\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Original reservation\", () => pm.expect(pm.response.json().reservation_id).to.eql(pm.collectionVariables.get(\"reservation_id\")));",
              "pm.test(\"Replay header\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Same key with changed seats declines",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A2\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-alice-first\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Bob cannot buy Alice seat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bob_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A1\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-bob-taken\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 All-or-nothing selection declines",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bob_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A1\",\n    \"A2\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-bob-multi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Quota rejects a fifth active seat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A2\",\n    \"A3\",\n    \"A4\",\n    \"A5\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-alice-limit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Spoofed body identity rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bob_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A6\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-spoof\",\n  \"user_id\": \"someone-else\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Bob cannot cancel Alice reservation",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/reservations/{{reservation_id}}/cancel",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bob_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Alice cancels",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/reservations/{{reservation_id}}/cancel",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Bob rebooks released A1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/shows/{{show_id}}/reserve",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bob_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\n    \"A1\"\n  ],\n  \"idempotency_key\": \"{{run_id}}-bob-rebook\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"bob_reservation_id\", pm.response.json().reservation_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Stale Alice cancellation is harmless",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/reservations/{{reservation_id}}/cancel",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{alice_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Final show reconciles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/shows/{{show_id}}",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const s = pm.response.json();",
              "pm.test(\"Counts reconcile\", () => pm.expect(s.counts.available + s.counts.held + s.counts.confirmed).to.eql(s.total_seats));",
              "pm.test(\"One confirmed seat remains\", () => pm.expect(s.counts.confirmed).to.eql(1));",
              "pm.collectionVariables.set(\"last_request_id\", pm.response.headers.get(\"X-Request-ID\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Prometheus metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/metrics",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Seat gauges present\", () => pm.expect(pm.response.text()).to.include(\"seats_available\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Correlated request log",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/logs?request_id={{last_request_id}}&limit=10",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correlated log is present\", () => pm.expect(pm.response.json().entries.length).to.be.above(0));"
            ]
          }
        }
      ]
    }
  ]
}
