# Save the actual values outside the checkout with mode 0600.
# Generate each secret independently with secrets.token_urlsafe(48).
POSTGRES_PASSWORD=replace-with-random-url-safe-secret
AUTH_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_TOKEN=replace-with-random-secret-at-least-24-characters
EDGE_NETWORK=asm_net

# Current dedicated-capacity limits; reduce these when restoring other services.
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2g
DB_CPU_LIMIT=2.0
DB_MEMORY_LIMIT=2g
