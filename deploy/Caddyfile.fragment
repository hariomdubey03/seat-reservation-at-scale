# Append to the existing Caddyfile; validate before a graceful reload.
# Caddy and this API share only the existing edge network.
seats.algocrafter.in {
	header >Cache-Control "no-store"
	reverse_proxy seat-reservation-api:8000 {
		transport http {
			# Shorter than Uvicorn's 5s idle timeout: avoid reusing a stale POST connection.
			keepalive 2s
			# Queue at the proxy instead of flooding the upstream TCP accept backlog.
			max_conns_per_host 256
			dial_timeout 10s
		}
	}
}
